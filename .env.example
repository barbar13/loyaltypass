# Copy to .env and fill in values before running locally
# On Railway: set these as environment variables in your service settings

PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=change_this_password

# SQLite path — on Railway, set to a path inside a mounted volume for persistence
# e.g. DATABASE_PATH=/data/loyaltypass.db  (then mount a volume at /data)
# DATABASE_PATH=

# Public URL used to build enrollment QR codes (set to your Railway domain)
# BASE_URL=https://your-app.up.railway.app

# Apple Wallet — optional, requires Apple Developer Program ($99/yr)
# APPLE_PASS_TYPE_ID=pass.com.yourcompany.loyalty
# APPLE_TEAM_ID=ABCDE12345
# APPLE_WWDR_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# APPLE_PASS_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# APPLE_PASS_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# APPLE_PASS_KEY_PASSPHRASE=optional-passphrase
